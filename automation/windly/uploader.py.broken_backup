    def apply_original_cost_bulk(self, item=None):
        def parse_cost_value(raw):
            if raw is None:
                return None
            if isinstance(raw, (int, float)):
                return int(raw)
            s = str(raw)
            nums = re.findall(r"\d[\d,]*", s)
            if not nums:
                return None
            digits = re.sub(r"[^\d]", "", nums[0])
            return int(digits) if digits else None

        source_currency_code = str(getattr(item, "price_currency", "") or "").strip().upper() if item else ""
        if source_currency_code == "VND" and item:
            raw_cost = getattr(item, "base_price_krw", None)
        else:
            raw_cost = getattr(item, "base_price", None) if item else None

        cost_value = parse_cost_value(raw_cost)
        if not cost_value:
            print(f"[Windly][WARN] ?먭? ?낅젰媛??놁쓬: base_price={raw_cost}")
            return

        print(f"[Windly] ?먭? ?쇨큵 蹂寃??쒖옉: {cost_value}")
        try:
            self.page.get_by_role("button", name="?쇨큵 蹂寃?).first.click()
            time.sleep(0.4)

            self.page.get_by_role("button", name="?먭? ?쇨큵 蹂寃?).first.click()
            time.sleep(0.6)

            popup = self.page.locator("div.ezzy6es7").filter(
                has=self.page.locator("div.ezzy6es5:has-text('?먭? ?쇨큵 蹂寃?)")
            ).last
            popup.wait_for(state="visible", timeout=5000)

            input_box = popup.locator("input[type='text']").first
            input_box.click()
            input_box.press("Control+A")
            input_box.fill("")
            input_box.type(str(cost_value), delay=10)
            time.sleep(0.2)

            popup.get_by_role("button", name="?곸슜?섍린").first.click()
            time.sleep(0.8)
            print("[Windly] ?먭? ?쇨큵 蹂寃??꾨즺")
        except Exception as e:
            print(f"[Windly][WARN] ?먭? ?쇨큵 蹂寃??ㅽ뙣: {e}")
