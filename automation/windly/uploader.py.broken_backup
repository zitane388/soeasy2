                print("[Windly] ?쒓렇 留ㅼ묶 ?ㅽ뙣 ???ㅽ궢")
                return False
            time.sleep(1)
            
            # ??移댄뀒怨좊━ ?쒗뵆由??곸슜
            template_key = getattr(item, "matched_category_template_key", None)
            if template_key:
                self.apply_category_template(template_key)
                time.sleep(1)
            else:
                print("[Windly] matched_category_template_key ?놁쓬 ??移댄뀒怨좊━ ?ㅽ궢")
            time.sleep(5)
            
            # ???먮낯URL ?낅뜲?댄듃
