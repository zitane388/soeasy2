            self.page.goto(WINDLY_INTEREST_URL, wait_until="domcontentloaded", timeout=90000)
            print("[Windly] ?섏씠吏 ?곌껐 ?꾨즺")

            close_event_popup(self.page)

            if not item.final_name:
                return False

            # ??寃????移대뱶 ?대┃
