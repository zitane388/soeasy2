    def select_tag(self, tag_text):
        search_box = self.page.locator("input[placeholder='?곹뭹紐?寃??]")
        search_box.wait_for(state="visible")

        search_box.fill("")
        time.sleep(0.3)
        search_box.type(tag_text)
        time.sleep(0.5)

        self.page.keyboard.press("Enter")
        time.sleep(5)

        cards = self.page.locator("div.product-card")
        cnt = cards.count()

        if cnt == 0:
            print("寃??寃곌낵 ?놁쓬")
            return False

        for i in range(cnt):
            card = cards.nth(i)
            text = card.inner_text()

            if tag_text.replace(" ", "") in text.replace(" ", ""):
                card.click()
                time.sleep(1)
                return True

        return False
    
