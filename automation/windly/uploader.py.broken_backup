            # ??2 ?곹뭹紐??꾩껜 ?좏깮
            self.page.keyboard.down("Control")
            self.page.keyboard.press("A")
            self.page.keyboard.up("Control")
            time.sleep(0.2)

            # ??3 湲???ш쾶 ?곸슜
            apply_font_large(self.page)
            time.sleep(0.2)

            move_cursor_to_bottom(self.page)
            self.page.keyboard.press("Enter")
            self.page.keyboard.press("Enter")
            self.page.keyboard.press("Enter")
            time.sleep(0.5)

            # ======================================================
            # ???곹뭹 ?대?吏 ?낅젰 (?듭뀡 ?대?吏 ?쒖쇅, 濡쒓퀬 ?쒓굅 諛섏쁺)
            # ======================================================
            print("[Windly] ?대?吏 ?낅줈???쒖옉 (1?μ뵫)")

            # ------------------------------------------------------
            # 1. ?듭뀡 ?대?吏 URL ?섏쭛 (?먮낯 湲곗?)
            # ------------------------------------------------------
            option_image_urls = set()

            for opt in item.parsed_raw.get("options", []):
                for v in opt.get("values", []):
                    img = v.get("image")
                    if isinstance(img, str) and img.startswith("http"):
                        option_image_urls.add(img)

            # ------------------------------------------------------
            # 2. logo_job_results 湲곕컲 ?뚯씪 ???먮낯 URL 留ㅽ븨
            # ------------------------------------------------------
            file_to_original_url = {}

            for r in getattr(item, "logo_job_results", []) or []:
                url = r.get("url")
                fp = r.get("file_path")
                if url and fp:
                    file_to_original_url[os.path.abspath(fp)] = url

            # ------------------------------------------------------
            # 3. ?듭뀡 ?대?吏 ?먮퀎 ?⑥닔
            # ------------------------------------------------------
            def is_option_image(src: str) -> bool:
                # URL??寃쎌슦
                if src.startswith("http"):
                    return src in option_image_urls

                # ?뚯씪 寃쎈줈??寃쎌슦 ???먮낯 URL濡??섏썝
                src_abs = os.path.abspath(src)
                original_url = file_to_original_url.get(src_abs)
                if original_url:
                    return original_url in option_image_urls

                return False

            # ------------------------------------------------------
            # 4. 理쒖쥌 ?낅줈??????대?吏 寃곗젙
            # ------------------------------------------------------
            upload_sources = [
                src for src in (item.final_image_sources or [])
                if not is_option_image(src)
            ]

            # ------------------------------------------------------
            # 5. URL / ?뚯씪 ?쇳빀 ?ㅼ슫濡쒕뱶 泥섎━
            # ------------------------------------------------------
            imgs = []

            for src in upload_sources:
                if src.startswith("http"):
                    paths = download_temp_images([src], self.windly_temp_path)
                    imgs.extend(paths)
                else:
                    imgs.append(os.path.abspath(src))

            # ------------------------------------------------------
            # 6. ????대?吏(媛怨??몃꽕?? ?곗꽑 諛곗튂
            # ------------------------------------------------------
            thumb = getattr(item, "make_thumbnail_img", None)
            if thumb:
                thumb_path = os.path.abspath(thumb)
                if os.path.exists(thumb_path):
                    imgs = [p for p in imgs if os.path.abspath(p) != thumb_path]
                    imgs.insert(0, thumb_path)

            # ------------------------------------------------------
            # 7. ?낅줈???ㅽ뻾
            # ------------------------------------------------------
            print("[Windly] 理쒖쥌 ?대?吏 ?쒖꽌:")
            for i, pth in enumerate(imgs):
                print(f"  {i+1}. {os.path.basename(pth)}")

            for img_path in imgs:
                copy_image_file(img_path)
                editor.click()
                move_cursor_to_bottom(self.page)
                self.page.keyboard.press("Control+V")
                time.sleep(0.5)

            time.sleep(2)


            move_cursor_to_bottom(self.page)
            self.page.keyboard.press("Enter")
            self.page.keyboard.press("Enter")
            self.page.keyboard.press("Enter")
            self.page.keyboard.press("Enter")
            time.sleep(0.5)

            # ???곸꽭?ㅻ챸
            copy_text(item.final_detail_text or "")
            editor.click()
            move_cursor_to_bottom(self.page)
            self.page.keyboard.press("Enter")
            time.sleep(0.5)
            self.page.keyboard.press("Control+V")
            time.sleep(2)

            self.page.keyboard.press("Enter")
            time.sleep(0.3)

            # ???ъ씠利덊몴
            if item.size_chart_image_path:
                print("[WINDLY] ?ъ씠利덊몴 遺숈뿬?ｊ린 ?쒕룄")
                copy_image_file(item.size_chart_image_path)
                editor.click()
                move_cursor_to_bottom(self.page)
                self.page.keyboard.press("Enter")
                time.sleep(0.5)
                self.page.keyboard.press("Control+V")
                self.page.keyboard.press("Enter")
                time.sleep(2)
            else:
                print("[WINDLY] ?ъ씠利덊몴 ?놁쓬 ???ㅽ궢")

            # ???듭뀡??
            if item.options_chart_path:
                print("[WINDLY] ?듭뀡??遺숈뿬?ｊ린 ?쒕룄")
                copy_image_file(item.options_chart_path)
                editor.click()
                move_cursor_to_bottom(self.page)
                self.page.keyboard.press("Enter")
                time.sleep(0.5)
                self.page.keyboard.press("Control+V")
                self.page.keyboard.press("Enter")
                time.sleep(2)
            else:
                print("[WINDLY] ?듭뀡???놁쓬 ???ㅽ궢")

            print("===== Windly ?낅젰 ?꾨즺 =====")
            return True

        except Exception as e:
            print("[WINDLY ERROR]", e)
            return False

        finally:
            try:
                if hasattr(self, "page") and self.page:
                    self.page.close()
                if hasattr(self, "browser") and self.browser:
                    self.browser.close()
                if hasattr(self, "p") and self.p:
                    self.p.stop()
            except Exception:
                pass

            print("[Windly] ?몄뀡 醫낅즺 ?꾨즺")
            cleanup_windly_temp(self.windly_temp_path)
