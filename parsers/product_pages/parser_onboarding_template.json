{
  "brand": "example_brand",
  "country": "jp",
  "sample_urls": [
    "https://example.com/product/sku-1",
    "https://example.com/product/sku-2",
    "https://example.com/product/sku-3"
  ],
  "mode": "html_blocks",
  "html_blocks": [
    {
      "block_name": "name_area",
      "purpose": "상품명 영역",
      "html": "<h1 class=\"product-title\">Example Item Name</h1>"
    },
    {
      "block_name": "brand_area",
      "purpose": "product brand tag block",
      "html": "<div class=\"brand-name\">NIKE</div>"
    },
    {
      "block_name": "model_area",
      "purpose": "product model number tag block",
      "html": "<div class=\"model-number\">HM6803-109</div>"
    },
    {
      "block_name": "price_area",
      "purpose": "가격 영역",
      "html": "<div class=\"price-current\">3,990</div>"
    },
    {
      "block_name": "images_area",
      "purpose": "대표/상세 이미지 영역",
      "html": "<div class=\"gallery\"><img src=\"https://.../main.jpg\" /></div>"
    },
    {
      "block_name": "options_area",
      "purpose": "옵션 축/값이 들어있는 영역",
      "html": "<ul class=\"color-list\">...</ul><ul class=\"size-list\">...</ul>"
    },
    {
      "block_name": "description_area",
      "purpose": "상세설명 영역",
      "html": "<section class=\"product-description\">...</section>"
    }
  ],
  "initial_data_scripts": [
    {
      "script_name": "__NEXT_DATA__",
      "purpose": "페이지 초기 상태 데이터(JSON)",
      "html": "<script id=\"__NEXT_DATA__\" type=\"application/json\">{...}</script>"
    }
  ],
  "dom_snapshots": [
    {
      "snapshot_name": "price_before",
      "action": "색상 BLACK + 사이즈 260 선택 후 가격 노드",
      "html": "<div class=\"price-current\">9,990</div>"
    },
    {
      "snapshot_name": "price_after",
      "action": "색상 BLUE + 사이즈 270 선택 후 가격 노드",
      "html": "<div class=\"price-current\">8,990</div>"
    },
    {
      "snapshot_name": "option_before",
      "action": "선택 전 옵션 버튼 노드",
      "html": "<button class=\"size-btn\">270</button>"
    },
    {
      "snapshot_name": "option_after",
      "action": "선택 후 옵션 버튼 노드",
      "html": "<button class=\"size-btn is-selected\">270</button>"
    }
  ],
  "har_file": "docs/har/example_brand_jp_options.har",
  "notes": [
    "sample_urls에는 정상 상품 2개 + 옵션 복잡/품절 케이스 1개를 넣어주세요.",
    "html_blocks / dom_snapshots 중 하나만 정확하게 제공해도 됩니다.",
    "HAR가 없어도 initial_data_scripts + dom_snapshots가 있으면 구현 가능합니다.",
    "har_file은 옵션 클릭 시점 네트워크가 포함된 HAR 경로를 넣어주세요."
  ]
}